{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},

  // Dell battery charge mode (BIOS setting, applied live via the kernel).
  "setup.battery": {"icon":"󰂄","label":"Battery Charging","aliases":["battery-charge"],"when":"[[ -e /sys/class/power_supply/BAT0/charge_types ]]"},
  "setup.battery.standard": {"icon":"󰁹","label":"Standard","description":"Charge to 100% (travel)","checked":"grep -q '\\[Standard\\]' /sys/class/power_supply/BAT0/charge_types","action":"pkexec sh -c 'echo Standard > /sys/class/power_supply/BAT0/charge_types'"},
  "setup.battery.adaptive": {"icon":"󰂃","label":"Adaptive","description":"Dell picks limits from usage","checked":"grep -q '\\[Adaptive\\]' /sys/class/power_supply/BAT0/charge_types","action":"pkexec sh -c 'echo Adaptive > /sys/class/power_supply/BAT0/charge_types'"},
  "setup.battery.custom": {"icon":"󰂀","label":"Custom","description":"Charge 60% → 80% (everyday)","checked":"grep -q '\\[Custom\\]' /sys/class/power_supply/BAT0/charge_types","action":"pkexec sh -c 'echo Custom > /sys/class/power_supply/BAT0/charge_types'"},
  "setup.battery.trickle": {"icon":"󰚥","label":"Primarily AC","description":"Low charge level for desk use","checked":"grep -q '\\[Trickle\\]' /sys/class/power_supply/BAT0/charge_types","action":"pkexec sh -c 'echo Trickle > /sys/class/power_supply/BAT0/charge_types'"},
  "setup.battery.fast": {"icon":"󱐋","label":"ExpressCharge","description":"Fastest charging, more wear","checked":"grep -q '\\[Fast\\]' /sys/class/power_supply/BAT0/charge_types","action":"pkexec sh -c 'echo Fast > /sys/class/power_supply/BAT0/charge_types'"},
}
