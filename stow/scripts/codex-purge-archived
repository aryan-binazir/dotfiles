class Abort(Exception):
    def __init__(self, code: int, message: str) -> None:
        super().__init__(message)
        self.code = code


class Locked(Exception):
    pass


# --------------------------------------------------------------------------
# Schema verification
# --------------------------------------------------------------------------


def schema_dump(conn: sqlite3.Connection) -> str:
    rows = conn.execute(
        "SELECT type, name, tbl_name, sql FROM sqlite_master "
        "WHERE sql IS NOT NULL ORDER BY type, name"
    ).fetchall()
    return "".join(f"-- {t} {n} on {tb}\n{sql}\n" for t, n, tb, sql in rows)


def migration_list(conn: sqlite3.Connection) -> list[tuple[int, str]]:
    return [
        (int(v), d)
        for v, d in conn.execute(
            "SELECT version, description FROM _sqlx_migrations ORDER BY version"
        )
    ]


def verify_schema(conn: sqlite3.Connection, name: str) -> None:
    try:
        got_migrations = migration_list(conn)
        got_schema = schema_dump(conn)
    except sqlite3.Error as exc:
        raise Abort(EXIT_SCHEMA, f"{name}: cannot inspect schema: {exc}") from exc
    if got_migrations != EXPECTED_MIGRATIONS[name]:
        diff = "\n".join(
            difflib.unified_diff(
                [f"{v} {d}" for v, d in EXPECTED_MIGRATIONS[name]],
                [f"{v} {d}" for v, d in got_migrations],
                "pinned", "actual", lineterm="",
            )
        )
        raise Abort(EXIT_SCHEMA, f"{name}: _sqlx_migrations differ from pinned list\n{diff}")
    if got_schema != EXPECTED_SCHEMA[name]:
        diff = "\n".join(
            difflib.unified_diff(
                EXPECTED_SCHEMA[name].splitlines(),
                got_schema.splitlines(),
                "pinned", "actual", lineterm="",
            )
        )
        raise Abort(EXIT_SCHEMA, f"{name}: schema differs from pinned schema\n{diff}")


def connect(path: Path, *, readonly: bool, timeout: float) -> sqlite3.Connection:
    if not path.is_file():
        raise Abort(EXIT_SCHEMA, f"{path.name}: database missing at {path}")
    mode = "ro" if readonly else "rw"
    conn = sqlite3.connect(
        f"file:{path}?mode={mode}", uri=True, timeout=timeout, isolation_level=None
    )
    return conn


# --------------------------------------------------------------------------
# Planning
# --------------------------------------------------------------------------


@dataclass
class Plan:
    rows: dict[str, str] = field(default_factory=dict)  # thread id -> rollout_path
    files: dict[str, list[Path]] = field(default_factory=dict)  # thread id -> files
    orphans: set[str] = field(default_factory=set)  # file exists, no thread row
    missing: set[str] = field(default_factory=set)  # row exists, file missing
    skipped: list[tuple[str, str]] = field(default_factory=list)

    @property
    def ids(self) -> list[str]:
        return sorted(set(self.rows) | self.orphans)

    def skip(self, key: str, reason: str) -> None:
        self.skipped.append((key, reason))


def validate_row_path(tid: str, rollout_path: str, archive_dir: str) -> str | None:
    if not os.path.isabs(rollout_path):
        return "rollout_path is not absolute"
    norm = os.path.normpath(rollout_path)
    if os.path.dirname(norm) != archive_dir:
        return "rollout_path is not inside archived_sessions/"
    match = ROLLOUT_RE.match(os.path.basename(norm))
    if match is None or match.group(2):
        return "rollout_path is not a rollout .jsonl file name"
    if match.group(1) != tid:
        return "rollout_path file name does not carry the thread id"
    if os.path.lexists(norm):
        st = os.lstat(norm)
        if stat.S_ISLNK(st.st_mode):
            return "rollout_path is a symlink"
        if not stat.S_ISREG(st.st_mode):
            return "rollout_path is not a regular file"
    return None


def writer_lock_held(home: Path, tid: str) -> bool:
    lock = home / WRITER_LOCK_DIR / f"{tid}.lock"
    try:
        fd = os.open(lock, os.O_RDONLY)
    except FileNotFoundError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        return True
    finally:
        os.close(fd)
    return False


def build_plan(home: Path, state: sqlite3.Connection) -> Plan:
    archive = home / ARCHIVE_DIR
    if archive.is_symlink():
        raise Abort(EXIT_SCHEMA, f"{ARCHIVE_DIR}/ is a symlink; refusing to operate")
    if not archive.is_dir():
        raise Abort(EXIT_SCHEMA, f"{ARCHIVE_DIR}/ missing at {archive}")
    archive_str = os.fspath(archive)

    plan = Plan()
    row_paths: dict[str, str] = {}
    for tid, rollout_path in state.execute(
        "SELECT id, rollout_path FROM threads WHERE archived = 1 ORDER BY id"
    ):
        reason = validate_row_path(tid, rollout_path, archive_str)
        if reason:
            plan.skip(tid, f"{reason} ({rollout_path})")
        else:
            row_paths[tid] = rollout_path

    files_by_id: dict[str, list[tuple[str, Path]]] = {}
    with os.scandir(archive) as entries:
        for entry in sorted(entries, key=lambda e: e.name):
            if entry.is_symlink():
                plan.skip(entry.name, "symlink in archived_sessions/; left alone")
                continue
            if not entry.is_file(follow_symlinks=False):
                plan.skip(entry.name, "not a regular file; left alone")
                continue
            match = ROLLOUT_RE.match(entry.name)
            if match is None:
                plan.skip(entry.name, "unrecognized file name; left alone")
                continue
            canonical = entry.path[:-4] if match.group(2) else entry.path
            files_by_id.setdefault(match.group(1), []).append((canonical, Path(entry.path)))

    for tid, rollout_path in row_paths.items():
        entries = files_by_id.pop(tid, [])
        if any(canonical != rollout_path for canonical, _ in entries):
            plan.skip(tid, "archived_sessions/ holds a file for this thread that does not match rollout_path")
            continue
        plan.rows[tid] = rollout_path
        plan.files[tid] = [path for _, path in entries]
        if not entries:
            plan.missing.add(tid)

    for tid, entries in files_by_id.items():
        row = state.execute(
            "SELECT archived, rollout_path FROM threads WHERE id = ?", (tid,)
        ).fetchone()
        if row is None:
            plan.orphans.add(tid)
            plan.files[tid] = [path for _, path in entries]
        elif row[0] != 1:
            plan.skip(tid, "file in archived_sessions/ but thread row is not archived; left alone")
        else:
            plan.skip(tid, "file in archived_sessions/ but archived row points elsewhere; left alone")

    for tid in plan.ids:
        if writer_lock_held(home, tid):
            plan.skip(tid, "thread writer lock is held by a running Codex process; left alone")
            plan.rows.pop(tid, None)
            plan.orphans.discard(tid)
            plan.missing.discard(tid)
            plan.files.pop(tid, None)
    return plan


# --------------------------------------------------------------------------
# Counting and jsonl filtering
# --------------------------------------------------------------------------

HISTORY_TABLES = (
    "thread_items",
    "thread_turns",
    "thread_realtime_items",
    "thread_history_projection_state",
)
STATE_TABLES = (
    ("thread_attachments", "thread_id"),
    ("thread_dynamic_tools", "thread_id"),
    ("thread_spawn_edges", "child_thread_id"),
    ("threads", "id"),
)
IN_IDS = "IN (SELECT value FROM json_each(?))"


def skipped_rollout_paths(home: Path, plan: Plan, ids: list[str]) -> list[str]:
    paths: list[str] = []
    for tid in ids:
        for path in plan.files.get(tid, []):
            paths.append(os.fspath(path))
            paths.append(os.path.relpath(path, home))
        if tid in plan.rows:
            paths.append(plan.rows[tid])
            paths.append(os.path.relpath(plan.rows[tid], home))
    return sorted(set(paths))


def count_rows(
    state: sqlite3.Connection, history: sqlite3.Connection, home: Path, plan: Plan, ids: list[str]
) -> dict[str, int]:
    ids_json = json.dumps(ids)
    counts: dict[str, int] = {}
    for table in HISTORY_TABLES:
        counts[table] = history.execute(
            f"SELECT COUNT(*) FROM {table} WHERE thread_id {IN_IDS}", (ids_json,)
        ).fetchone()[0]
    for table, column in STATE_TABLES:
        counts[table] = state.execute(
            f"SELECT COUNT(*) FROM {table} WHERE {column} {IN_IDS}", (ids_json,)
        ).fetchone()[0]
    counts["rollout_migration_skipped_rollouts"] = state.execute(
        f"SELECT COUNT(*) FROM rollout_migration_skipped_rollouts WHERE rollout_path {IN_IDS}",
        (json.dumps(skipped_rollout_paths(home, plan, ids)),),
    ).fetchone()[0]
    return counts


def filter_jsonl(data: bytes, key: str, ids: set[str]) -> tuple[bytes, int]:
    kept: list[bytes] = []
    removed = 0
    for line in data.splitlines(keepends=True):
        text = line.strip()
        if text:
            try:
                obj = json.loads(text)
            except ValueError:
                obj = None
            if isinstance(obj, dict) and obj.get(key) in ids:
                removed += 1
                continue
        kept.append(line)
    return b"".join(kept), removed


JSONL_FILES = ((HISTORY_JSONL, "session_id"), (SESSION_INDEX_JSONL, "id"))


def count_jsonl(home: Path, ids: set[str]) -> dict[str, int]:
    counts = {}
    for name, key in JSONL_FILES:
        path = home / name
        counts[name] = filter_jsonl(path.read_bytes(), key, ids)[1] if path.is_file() else 0
    return counts


# --------------------------------------------------------------------------
# Execution
# --------------------------------------------------------------------------


def lock_file(path: Path, timeout: float) -> int | None:
    try:
        fd = os.open(path, os.O_RDWR)
    except FileNotFoundError:
        return None
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except OSError:
            if time.monotonic() >= deadline:
                os.close(fd)
                raise Locked(f"{path.name}: flock is held by another process")
            time.sleep(0.05)


def begin_immediate(conn: sqlite3.Connection, name: str) -> None:
    try:
        conn.execute("BEGIN IMMEDIATE")
    except sqlite3.OperationalError as exc:
        raise Locked(f"{name}: {exc}") from exc


def rewrite_locked(fd: int, key: str, ids: set[str]) -> int:
    with os.fdopen(os.dup(fd), "r+b") as f:
        f.seek(0)
        data = f.read()
        new, removed = filter_jsonl(data, key, ids)
        if removed:
            f.seek(0)
            f.truncate()
            f.write(new)
            f.flush()
            os.fsync(f.fileno())
    return removed


def unlink_regular(path: Path) -> bool:
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        return False
    if not stat.S_ISREG(st.st_mode):
        raise OSError(f"{path}: not a regular file at unlink time; left alone")
    os.unlink(path)
    return True


def execute(home: Path, plan: Plan, timeout: float) -> tuple[dict[str, int], list[str]]:
    state = connect(home / STATE_DB, readonly=False, timeout=timeout)
    history = connect(home / HISTORY_DB, readonly=False, timeout=timeout)
    verify_schema(state, STATE_DB)
    verify_schema(history, HISTORY_DB)

    fds: list[tuple[str, str, int]] = []
    in_txn: list[sqlite3.Connection] = []

    def release() -> None:
        for conn in in_txn:
            try:
                conn.execute("ROLLBACK")
            except sqlite3.Error:
                pass
        in_txn.clear()
        for _, _, fd in fds:
            os.close(fd)
        fds.clear()

    try:
        for name, key in JSONL_FILES:
            fd = lock_file(home / name, timeout)
            if fd is not None:
                fds.append((name, key, fd))
        begin_immediate(history, HISTORY_DB)
        in_txn.append(history)
        begin_immediate(state, STATE_DB)
        in_txn.append(state)
    except Locked as exc:
        release()
        raise Abort(EXIT_LOCKED, f"could not acquire locks, nothing deleted: {exc}") from exc

    try:
        # Re-check inside the write transaction so concurrent unarchive/delete
        # activity since planning cannot be overwritten.
        changed: list[str] = []
        confirmed: list[str] = []
        for tid in plan.ids:
            row = state.execute(
                "SELECT archived, rollout_path FROM threads WHERE id = ?", (tid,)
            ).fetchone()
            if tid in plan.rows:
                ok = row is not None and row[0] == 1 and row[1] == plan.rows[tid]
            else:
                ok = row is None
            (confirmed if ok else changed).append(tid)

        counts = {"threads_confirmed": len(confirmed), "threads_changed": len(changed)}
        ids_json = json.dumps(confirmed)
        for table in HISTORY_TABLES:
            counts[table] = history.execute(
                f"DELETE FROM {table} WHERE thread_id {IN_IDS}", (ids_json,)
            ).rowcount
        for table, column in STATE_TABLES:
            counts[table] = state.execute(
                f"DELETE FROM {table} WHERE {column} {IN_IDS}", (ids_json,)
            ).rowcount
        counts["rollout_migration_skipped_rollouts"] = state.execute(
            f"DELETE FROM rollout_migration_skipped_rollouts WHERE rollout_path {IN_IDS}",
            (json.dumps(skipped_rollout_paths(home, plan, confirmed)),),
        ).rowcount

        id_set = set(confirmed)
        for name, key, fd in fds:
            counts[name] = rewrite_locked(fd, key, id_set)
        for name, _ in JSONL_FILES:
            counts.setdefault(name, 0)

        history.execute("COMMIT")
        in_txn.remove(history)
        state.execute("COMMIT")
        in_txn.remove(state)
    finally:
        release()
        state.close()
        history.close()

    unlinked = 0
    failures: list[str] = []
    for tid in confirmed:
        for path in plan.files.get(tid, []):
            try:
                unlinked += unlink_regular(path)
            except OSError as exc:
                failures.append(str(exc))
    counts["files"] = unlinked
    return counts, changed + failures


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------


def print_plan(plan: Plan, counts: dict[str, int], jsonl: dict[str, int], verbose: bool) -> None:
    print(f"archived thread rows to delete: {len(plan.rows)}")
    print(f"  with transcript file:         {len(plan.rows) - len(plan.missing)}")
    print(f"  transcript already missing:   {len(plan.missing)}")
    print(f"orphan transcript files (no thread row): {len(plan.orphans)}")
    print(f"transcript files to unlink: {sum(len(v) for v in plan.files.values())}")
    print("database rows to delete:")
    for table in HISTORY_TABLES:
        print(f"  {HISTORY_DB}/{table}: {counts[table]}")
    for table, _ in STATE_TABLES:
        print(f"  {STATE_DB}/{table}: {counts[table]}")
    print(f"  {STATE_DB}/rollout_migration_skipped_rollouts: {counts['rollout_migration_skipped_rollouts']}")
    print("jsonl lines to delete:")
    for name, _ in JSONL_FILES:
        print(f"  {name}: {jsonl[name]}")
    if verbose:
        print("thread ids:")
        for tid in plan.ids:
            print(f"  {tid}")
    if plan.skipped:
        print(f"skipped, left untouched ({len(plan.skipped)}):")
        for key, reason in plan.skipped:
            print(f"  {key}: {reason}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="codex-purge-archived",
        description="Permanently delete archived Codex sessions and their metadata.",
    )
    parser.add_argument("--dry-run", action="store_true", help="report only; change nothing")
    parser.add_argument(
        "--codex-home",
        type=Path,
        default=Path(os.environ.get("CODEX_HOME", "~/.codex")),
        help="Codex home directory (default: $CODEX_HOME or ~/.codex)",
    )
    parser.add_argument(
        "--lock-timeout", type=float, default=5.0, help="seconds to wait for locks (default 5)"
    )
    parser.add_argument("-y", "--yes", action="store_true", help="skip the confirmation prompt")
    parser.add_argument("-v", "--verbose", action="store_true", help="list thread ids")
    parser.add_argument(
        "--print-schema", action="store_true",
        help="print the live schema dump in pinned format and exit (for re-pinning)",
    )
    args = parser.parse_args(argv)

    home = args.codex_home.expanduser()
    try:
        if not home.is_dir():
            raise Abort(EXIT_ERROR, f"codex home is not a directory: {home}")
        home = home.resolve()

        if args.print_schema:
            for name in (STATE_DB, HISTORY_DB):
                conn = connect(home / name, readonly=True, timeout=args.lock_timeout)
                print(f"##### {name}\nMIGRATIONS = {migration_list(conn)!r}\n{schema_dump(conn)}")
                conn.close()
            return EXIT_OK

        state = connect(home / STATE_DB, readonly=True, timeout=args.lock_timeout)
        history = connect(home / HISTORY_DB, readonly=True, timeout=args.lock_timeout)
        verify_schema(state, STATE_DB)
        verify_schema(history, HISTORY_DB)
        plan = build_plan(home, state)
        counts = count_rows(state, history, home, plan, plan.ids)
        jsonl = count_jsonl(home, set(plan.ids))
        state.close()
        history.close()

        print(f"codex home: {home}")
        print("mode: DRY RUN" if args.dry_run else "mode: LIVE")
        print_plan(plan, counts, jsonl, args.verbose)
        if args.dry_run or not plan.ids:
            if not plan.ids:
                print("nothing to delete")
            return EXIT_OK

        if not args.yes and sys.stdin.isatty():
            answer = input(f"Permanently delete {len(plan.ids)} archived threads? [y/N] ")
            if answer.strip().lower() not in ("y", "yes"):
                print("aborted")
                return EXIT_ERROR

        done, problems = execute(home, plan, args.lock_timeout)
        print("deleted:")
        for key in sorted(done):
            print(f"  {key}: {done[key]}")
        if problems:
            print(f"problems ({len(problems)}); rerun to reclaim:")
            for item in problems:
                print(f"  {item}")
            return EXIT_ERROR
        return EXIT_OK
    except Abort as exc:
        print(f"error: {exc}", file=sys.stderr)
        return exc.code


if __name__ == "__main__":
    sys.exit(main())
