#!/usr/bin/env python3
"""Desktop notifications for tmux agent attention."""

import argparse
import html
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys


def run(*args, input=None, timeout=5):
    return subprocess.run(args, input=input, text=True, capture_output=True,
                          check=True, timeout=timeout).stdout.strip()


def click_argv(socket, pane):
    # Notifiers run clicks with a minimal PATH (launchd on macOS), so carry ours for tmux and fzf.
    return ["/usr/bin/env", "PATH=" + os.environ.get("PATH", ""), sys.executable,
            str(Path(__file__).resolve()), "click", "--socket", socket, "--pane", pane]


def click(socket, pane):
    if shutil.which("omarchy-hyprland-focus-app"):
        try:
            run("omarchy-hyprland-focus-app", "com.mitchellh.ghostty")
        except subprocess.SubprocessError:
            pass
    rows = [row.split("\t", 1) for row in
            run("tmux", "-S", socket, "list-clients", "-f", "#{!:#{client_control_mode}}",
                "-F", "#{client_activity}\t#{client_name}").splitlines()]
    if not rows:
        return
    client = max(rows, key=lambda row: int(row[0]))[1]
    picker = Path(__file__).resolve().with_name("tmux-agent-picker")
    subprocess.Popen([sys.executable, str(picker), "open", "--socket", socket, "--client", client, "--focus", pane],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def pending_attention(socket, pane, event):
    state, current_event = run("tmux", "-S", socket, "display-message", "-p", "-t", pane,
                               "#{@ai_attention_state}|#{@ai_attention_event}").split("|")
    if (state in ("done", "blocked", "blocked-quiet1", "blocked-quiet2") and (event is None or current_event == event)
            and run("tmux", "-S", socket, "show-options", "-gqv", "@ai_notifications") != "off"):
        return state
    return None


def notify(socket, pane, event=None):
    state = pending_attention(socket, pane, event)
    if not state:
        return
    label = run("tmux", "-S", socket, "display-message", "-p", "-t", pane,
                "W #{window_index} P #{pane_index}")
    label = " ".join(label.split())[:240]
    title = "Agent needs input" if state.startswith("blocked") else "Agent turn finished"
    platform = run("uname", "-s")
    if platform == "Linux":
        run("notify-send", "--app-name=tmux", "--hint=boolean:suppress-sound:true",
            "--hint=string:omarchy-exec-argv:" + json.dumps(click_argv(socket, pane)),
            "--", title, html.escape(label))
    elif platform == "Darwin":
        if shutil.which("terminal-notifier"):
            run("terminal-notifier", "-title", title, "-message", label,
                "-activate", "com.mitchellh.ghostty", "-execute", shlex.join(click_argv(socket, pane)), timeout=None)
        else:
            run("osascript", "-", title, label,
                input='on run argv\ndisplay notification (item 2 of argv) with title (item 1 of argv)\nend run')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    notification = commands.add_parser("notify")
    notification.add_argument("--socket", required=True)
    notification.add_argument("--pane", required=True)
    notification.add_argument("--event")
    navigation = commands.add_parser("click")
    navigation.add_argument("--socket", required=True)
    navigation.add_argument("--pane", required=True)
    args = parser.parse_args()
    try:
        if args.command == "notify":
            notify(args.socket, args.pane, args.event)
        else:
            click(args.socket, args.pane)
    except (OSError, ValueError, subprocess.SubprocessError):
        return


if __name__ == "__main__":
    main()
