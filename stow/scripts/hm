#!/usr/bin/env bash

set -euo pipefail

if [[ ${HERDR_ENV:-} != 1 ]]; then
    echo "error: hm must run inside Herdr" >&2
    exit 1
fi

if (( $# > 1 )); then
    echo "usage: hm [directory]" >&2
    exit 2
fi

if (( $# == 1 )); then
    selected=$1
else
    selected=$(fzf < <(find ~ -mindepth 1 -maxdepth 6 \
        \( -name node_modules -o -name '.*' ! -name .config ! -name .worktrees \) -prune -o \
        -type d \( -path ~/repos/\* -o ! -path ~/\*/\*/\*/\*/\*/\* \) -print 2>/dev/null)) || exit 0
fi

[[ -n $selected ]] || exit 0

if [[ ! -d $selected ]]; then
    echo "error: not a directory: $selected" >&2
    exit 1
fi

selected=$(realpath -- "$selected")
selected_name=$(basename "$selected" | tr . _)
workspace_id=$(
    herdr workspace list |
        jq -r --arg dir "$selected/" --arg label "$selected_name" --argjson panes "$(herdr pane list)" '
            [$panes.result.panes[] | select(.cwd + "/" | startswith($dir)) | .workspace_id] as $ids
            | first(.result.workspaces[] | select(.label == $label and IN(.workspace_id; $ids[])))
            | .workspace_id
        '
)

if [[ -n $workspace_id ]]; then
    herdr workspace focus "$workspace_id" >/dev/null
else
    herdr workspace create \
        --cwd "$selected" \
        --label "$selected_name" \
        --focus >/dev/null
fi
