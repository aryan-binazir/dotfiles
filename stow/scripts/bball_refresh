#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


REPOS = (
    Path("/home/ar/repos/bball-lab-go"),
    Path("/home/ar/repos/bball-lab-ts"),
)
GO_REPO = Path("/home/ar/repos/bball-lab-go")


def run(argv: list[str], cwd: Path) -> int:
    print(f"\n[{cwd}] $ {' '.join(argv)}", flush=True)
    return subprocess.run(argv, cwd=cwd).returncode


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Refresh the local bball-lab k3d stack.",
    )
    parser.add_argument(
        "--dev",
        action="store_true",
        help="Roll the local stack without stashing, pulling, or changing branches.",
    )
    return parser.parse_args(argv)


def refresh_stack() -> int:
    return run(["make", "rolling-refresh"], GO_REPO)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)

    for repo in REPOS:
        if not repo.is_dir():
            print(f"missing repo: {repo}", file=sys.stderr)
            return 1

    if args.dev:
        print("dev mode: skipping git stash, gb, and branch changes", flush=True)
        return refresh_stack()

    for repo in REPOS:
        status = run(["gb"], repo)
        if status != 0:
            return status

    return refresh_stack()


if __name__ == "__main__":
    raise SystemExit(main())
