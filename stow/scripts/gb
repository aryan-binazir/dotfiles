#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

import os
from pathlib import Path
import subprocess
import sys


def run(command: list[str], *, cwd: Path | None = None) -> int:
    try:
        return subprocess.run(command, cwd=cwd).returncode
    except FileNotFoundError:
        print(f"error: command not found: {command[0]}", file=sys.stderr)
        return 127


def ensure_jj_repo() -> int:
    try:
        root = subprocess.run(
            ["jj", "root"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("error: command not found: jj", file=sys.stderr)
        return 127
    if root.returncode == 0:
        return 0

    try:
        git_root = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("error: command not found: git", file=sys.stderr)
        return 127
    if git_root.returncode != 0:
        print("error: not inside a jj or Git repository", file=sys.stderr)
        return 1

    return run(
        ["jj", "git", "init", "--colocate"],
        cwd=Path(git_root.stdout.strip()),
    )


def main() -> int:
    args = sys.argv[1:]
    branch = args[0] if len(args) >= 1 else "main"
    cmd = args[1] if len(args) >= 2 else ""

    if branch.startswith("-"):
        print(f"error: invalid branch name: {branch}", file=sys.stderr)
        return 1

    result = ensure_jj_repo()
    if result != 0:
        return result

    # Colocated jj repos can accumulate thousands of loose refs/jj/keep refs.
    # Packing them avoids an expensive one-file-at-a-time scan on every jj command.
    for sync_cmd in (
        ["git", "pack-refs", "--all", "--prune"],
        ["jj", "git", "fetch", "--remote", "origin", "--branch", branch],
        ["jj", "new", f"{branch}@origin"],
    ):
        result = run(sync_cmd)
        if result != 0:
            return result

    if cmd:
        if cmd == "acc":
            launch = ["claude", "--permission-mode", "auto"]
        elif cmd == "acd":
            launch = [
                "codex",
                "--sandbox",
                "workspace-write",
                "--ask-for-approval",
                "on-request",
                "-c",
                "approvals_reviewer=auto_review",
            ]
        else:
            print(f"unknown command: {cmd} (expected acc, or acd)", file=sys.stderr)
            return 1
        try:
            os.execvp(launch[0], launch)
        except FileNotFoundError:
            print(f"error: command not found: {launch[0]}", file=sys.stderr)
            return 127

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        raise SystemExit(130)
    except Exception as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
