#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

import os
from pathlib import Path
import shlex
import subprocess
import sys

GIT_STATES = (
    ("MERGE_HEAD", "merge"),
    ("rebase-merge", "rebase"),
    ("rebase-apply", "rebase"),
    ("CHERRY_PICK_HEAD", "cherry-pick"),
    ("REVERT_HEAD", "revert"),
    ("BISECT_LOG", "bisect"),
    ("sequencer", "sequencer"),
)


def git(
    *args: str,
    root: Path | None = None,
    capture: bool = False,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=root,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.DEVNULL if capture else None,
    )


def git_root() -> Path | None:
    try:
        result = git("rev-parse", "--show-toplevel", capture=True)
    except FileNotFoundError:
        print("error: command not found: git", file=sys.stderr)
        return None
    if result.returncode != 0:
        print("error: not inside a Git repository", file=sys.stderr)
        return None
    return Path(result.stdout.removesuffix("\n"))


def existing_branch(root: Path, name: str) -> bool:
    for ref in (f"refs/heads/{name}", f"refs/remotes/origin/{name}"):
        result = git("show-ref", "--verify", "--quiet", ref, root=root)
        if result.returncode == 0:
            return True
        if result.returncode != 1:
            raise RuntimeError(
                f"git show-ref failed with exit status {result.returncode}"
            )
    return False


def parse_args(args: list[str], root: Path) -> tuple[str, list[str]]:
    if args and existing_branch(root, args[0]):
        return args[0], args[1:]
    return "main", args


def exec_command(cmd: list[str]) -> int:
    try:
        os.execvp(cmd[0], cmd)
    except OSError:
        pass
    shell = os.environ.get("SHELL", "bash")
    try:
        os.execvp(shell, [shell, "-ic", shlex.join(cmd)])
    except OSError:
        print(f"error: command not found: {cmd[0]}", file=sys.stderr)
    return 127


def in_progress_operation(root: Path) -> str | None:
    result = git("rev-parse", "--git-dir", root=root, capture=True)
    if result.returncode != 0:
        raise RuntimeError("cannot locate the Git directory")
    git_dir = Path(result.stdout.removesuffix("\n"))
    if not git_dir.is_absolute():
        git_dir = root / git_dir
    for name, label in GIT_STATES:
        if (git_dir / name).exists():
            return label
    return None


def gone_branches(root: Path) -> list[str]:
    result = git(
        "for-each-ref",
        "refs/heads",
        "--format=%(refname:short)\t%(upstream:track)",
        root=root,
        capture=True,
    )
    if result.returncode != 0:
        raise RuntimeError("cannot inspect local branch upstreams")

    branches = []
    for line in result.stdout.splitlines():
        branch, _, tracking = line.partition("\t")
        if tracking == "[gone]":
            branches.append(branch)
    return branches


def branch_worktrees(root: Path) -> dict[str, tuple[Path, bool]]:
    result = git("worktree", "list", "--porcelain", root=root, capture=True)
    if result.returncode != 0:
        raise RuntimeError("cannot inspect Git worktrees")

    worktrees = {}
    for index, record in enumerate(result.stdout.rstrip("\n").split("\n\n")):
        path: Path | None = None
        branch: str | None = None
        for line in record.splitlines():
            if line.startswith("worktree "):
                path = Path(line.removeprefix("worktree "))
            elif line.startswith("branch refs/heads/"):
                branch = line.removeprefix("branch refs/heads/")
        if path is not None and branch is not None:
            worktrees[branch] = (path, index != 0)
    return worktrees


def prune_gone_branch(
    root: Path,
    branch: str,
    worktree: tuple[Path, bool] | None,
) -> None:
    if worktree is not None:
        path, is_linked = worktree
        if not is_linked:
            print(
                f"gb: skipped local branch {branch} "
                f"(primary worktree: {path})",
                file=sys.stderr,
            )
            return

        operation = in_progress_operation(path)
        if operation:
            print(
                f"gb: skipped local branch {branch} "
                f"({operation} in progress: {path})",
                file=sys.stderr,
            )
            return

        status = git("status", "--porcelain", root=path, capture=True)
        if status.returncode != 0:
            raise RuntimeError(
                f"git status failed with exit status {status.returncode}"
            )
        if status.stdout:
            print(
                f"gb: skipped local branch {branch} "
                f"(dirty worktree: {path})",
                file=sys.stderr,
            )
            return

        result = git("worktree", "remove", str(path), root=root, capture=True)
        if result.returncode != 0:
            raise RuntimeError(
                f"git worktree remove failed with exit status {result.returncode}"
            )

    result = git("branch", "-D", "--", branch, root=root, capture=True)
    if result.returncode != 0:
        raise RuntimeError(
            f"git branch -D failed with exit status {result.returncode}"
        )
    print(
        f"gb: pruned local branch {branch} (upstream gone)",
        file=sys.stderr,
    )


def prune_gone_branches(root: Path, current_branch: str) -> None:
    try:
        branches = gone_branches(root)
        worktrees = branch_worktrees(root)
    except Exception as error:
        print(f"gb: warning: local branch pruning failed: {error}", file=sys.stderr)
        return

    for branch in branches:
        if branch in ("main", current_branch):
            continue
        try:
            prune_gone_branch(root, branch, worktrees.get(branch))
        except Exception as error:
            print(
                f"gb: warning: failed to prune local branch {branch}: {error}",
                file=sys.stderr,
            )


def main() -> int:
    root = git_root()
    if root is None:
        return 1

    head = git("symbolic-ref", "-q", "--short", "HEAD", root=root, capture=True)
    if head.returncode:
        print("error: refusing to leave a detached Git HEAD", file=sys.stderr)
        return 1
    current_branch = head.stdout.removesuffix("\n")

    operation = in_progress_operation(root)
    if operation:
        print(f"error: refusing to interrupt {operation}", file=sys.stderr)
        return 1

    result = git("fetch", "--prune", "origin", root=root)
    if result.returncode != 0:
        return result.returncode

    prune_gone_branches(root, current_branch)

    branch, cmd = parse_args(sys.argv[1:], root)

    if not branch or branch.startswith("-"):
        print(f"error: invalid branch name: {branch}", file=sys.stderr)
        return 1

    if git("check-ref-format", "--branch", branch, root=root, capture=True).returncode:
        print(f"error: invalid branch name: {branch}", file=sys.stderr)
        return 1

    status = git("status", "--porcelain", root=root, capture=True)
    if status.returncode != 0:
        return status.returncode
    if status.stdout:
        result = git(
            "stash",
            "push",
            "--include-untracked",
            "-m",
            f"gb auto-stash before syncing {branch}",
            root=root,
        )
        if result.returncode != 0:
            return result.returncode
        print(
            "gb: stashed local changes; restore with git stash pop",
            file=sys.stderr,
        )

    local_branch = git(
        "show-ref", "--verify", "--quiet", f"refs/heads/{branch}", root=root
    )
    if local_branch.returncode == 0:
        switch = ("switch", branch)
    elif local_branch.returncode == 1:
        switch = ("switch", "--track", "-c", branch, f"origin/{branch}")
    else:
        return local_branch.returncode

    result = git(*switch, root=root)
    if result.returncode != 0:
        return result.returncode

    result = git("merge", "--ff-only", f"origin/{branch}", root=root)
    if result.returncode != 0:
        return result.returncode

    if cmd:
        return exec_command(cmd)
    return 0


if __name__ == "__main__":
    try:
        code = main()
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        code = 130
    except Exception as error:
        print(f"error: {error}", file=sys.stderr)
        code = 1
    raise SystemExit(code)
