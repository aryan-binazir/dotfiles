#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

import os
from pathlib import Path
import subprocess
import sys


AGENT_COMMANDS = {
    "acc": ["claude", "--permission-mode", "auto"],
    "acd": [
        "codex",
        "--sandbox",
        "workspace-write",
        "--ask-for-approval",
        "on-request",
        "-c",
        "approvals_reviewer=auto_review",
    ],
}


def run(command: list[str], *, cwd: Path | None = None) -> int:
    try:
        return subprocess.run(command, cwd=cwd).returncode
    except FileNotFoundError:
        print(f"error: command not found: {command[0]}", file=sys.stderr)
        return 127


def git_root() -> Path | None:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("error: command not found: git", file=sys.stderr)
        return None
    if result.returncode != 0:
        print("error: not inside a Git repository", file=sys.stderr)
        return None
    return Path(result.stdout.strip())


def main() -> int:
    args = sys.argv[1:]
    if not args:
        branch = "main"
        cmd = ""
    elif args[0] in AGENT_COMMANDS:
        branch = "main"
        cmd = args[0]
    else:
        branch = args[0]
        cmd = args[1] if len(args) >= 2 else ""

    if len(args) > 2 or (args and args[0] in AGENT_COMMANDS and len(args) > 1):
        print("error: usage: gb [branch] [acc|acd]", file=sys.stderr)
        return 1
    if cmd and cmd not in AGENT_COMMANDS:
        print(f"unknown command: {cmd} (expected acc, or acd)", file=sys.stderr)
        return 1

    if not branch or branch.startswith("-"):
        print(f"error: invalid branch name: {branch}", file=sys.stderr)
        return 1

    root = git_root()
    if root is None:
        return 1

    branch_check = subprocess.run(
        ["git", "check-ref-format", "--branch", branch],
        cwd=root,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if branch_check.returncode != 0:
        print(f"error: invalid branch name: {branch}", file=sys.stderr)
        return 1

    head = subprocess.run(
        ["git", "symbolic-ref", "-q", "HEAD"],
        cwd=root,
        stdout=subprocess.DEVNULL,
    )
    if head.returncode != 0:
        print("error: refusing to leave a detached Git HEAD", file=sys.stderr)
        return 1

    repository_states = (
        ("merge", "MERGE_HEAD"),
        ("rebase", "rebase-merge"),
        ("rebase", "rebase-apply"),
        ("cherry-pick", "CHERRY_PICK_HEAD"),
        ("revert", "REVERT_HEAD"),
        ("bisect", "BISECT_LOG"),
        ("sequencer operation", "sequencer"),
    )
    for state_name, git_path in repository_states:
        path_result = subprocess.run(
            ["git", "rev-parse", "--git-path", git_path],
            cwd=root,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        if path_result.returncode != 0:
            return path_result.returncode
        state_path = Path(path_result.stdout.strip())
        if not state_path.is_absolute():
            state_path = root / state_path
        if state_path.exists():
            print(f"error: refusing to interrupt {state_name}", file=sys.stderr)
            return 1

    status = subprocess.run(
        ["git", "status", "--porcelain"],
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
    )
    if status.returncode != 0:
        return status.returncode
    if status.stdout:
        result = run(
            [
                "git",
                "stash",
                "push",
                "--include-untracked",
                "-m",
                f"gb auto-stash before syncing {branch}",
            ],
            cwd=root,
        )
        if result != 0:
            return result

    result = run(["git", "fetch", "--prune", "origin", branch], cwd=root)
    if result != 0:
        return result

    local_branch = subprocess.run(
        ["git", "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
        cwd=root,
    )
    if local_branch.returncode == 0:
        switch = ["git", "switch", branch]
    elif local_branch.returncode == 1:
        switch = ["git", "switch", "--track", "-c", branch, f"origin/{branch}"]
    else:
        return local_branch.returncode

    result = run(switch, cwd=root)
    if result != 0:
        return result

    result = run(["git", "merge", "--ff-only", f"origin/{branch}"], cwd=root)
    if result != 0:
        return result

    if cmd:
        launch = AGENT_COMMANDS[cmd]
        try:
            os.execvp(launch[0], launch)
        except FileNotFoundError:
            print(f"error: command not found: {launch[0]}", file=sys.stderr)
            return 127

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        raise SystemExit(130)
    except Exception as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
