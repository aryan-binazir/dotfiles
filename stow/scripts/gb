#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

import os
from collections import Counter
from pathlib import Path
import shlex
import subprocess
import sys

GIT_STATES = (
    ("MERGE_HEAD", "merge"),
    ("rebase-merge", "rebase"),
    ("rebase-apply", "rebase"),
    ("CHERRY_PICK_HEAD", "cherry-pick"),
    ("REVERT_HEAD", "revert"),
    ("BISECT_LOG", "bisect"),
    ("sequencer", "sequencer"),
)


def git(
    *args: str,
    root: Path | None = None,
    capture: bool = False,
    input: str | None = None,
    original_objects: bool = False,
) -> subprocess.CompletedProcess[str]:
    environment = os.environ.copy()
    if original_objects:
        environment.update(GIT_NO_REPLACE_OBJECTS="1",
                           GIT_GRAFT_FILE=str(Path(os.devnull) / "grafts"))
    result = subprocess.run(
        ["git", "-c", "maintenance.auto=false", "-c", "gc.auto=0", *args],
        cwd=root,
        env=environment,
        input=os.fsencode(input) if input is not None else None,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.DEVNULL if capture else None,
    )
    return subprocess.CompletedProcess(
        result.args, result.returncode,
        os.fsdecode(result.stdout) if result.stdout is not None else None,
        os.fsdecode(result.stderr) if result.stderr is not None else None,
    )


def git_root() -> Path | None:
    try:
        result = git("rev-parse", "--show-toplevel", capture=True)
    except FileNotFoundError:
        print("error: command not found: git", file=sys.stderr)
        return None
    if result.returncode != 0:
        print("error: not inside a Git repository", file=sys.stderr)
        return None
    return Path(result.stdout.removesuffix("\n"))


def existing_branch(root: Path, name: str) -> bool:
    for ref in (f"refs/heads/{name}", f"refs/remotes/origin/{name}"):
        result = git("show-ref", "--verify", "--quiet", ref, root=root)
        if result.returncode == 0:
            return True
        if result.returncode != 1:
            raise RuntimeError(
                f"git show-ref failed with exit status {result.returncode}"
            )
    return False


def parse_args(args: list[str], root: Path) -> tuple[str, list[str]]:
    if args:
        requested = args[0]
        candidates = (
            (f"amb/{requested}", requested) if "/" not in requested else (requested,)
        )
        for branch in candidates:
            if existing_branch(root, branch):
                return branch, args[1:]
    return "main", args


def exec_command(cmd: list[str]) -> int:
    try:
        os.execvp(cmd[0], cmd)
    except OSError:
        pass
    shell = os.environ.get("SHELL", "bash")
    try:
        os.execvp(shell, [shell, "-ic", shlex.join(cmd)])
    except OSError:
        print(f"error: command not found: {cmd[0]}", file=sys.stderr)
    return 127


def in_progress_operation(root: Path) -> str | None:
    result = git("rev-parse", "--git-dir", root=root, capture=True)
    if result.returncode != 0:
        raise RuntimeError("cannot locate the Git directory")
    git_dir = Path(result.stdout.removesuffix("\n"))
    if not git_dir.is_absolute():
        git_dir = root / git_dir
    for name, label in GIT_STATES:
        if (git_dir / name).exists():
            return label
    return None


def gone_branches(root: Path) -> list[str]:
    result = git(
        "for-each-ref",
        "refs/heads",
        "--format=%(refname)\t%(upstream:track)",
        root=root,
        capture=True,
    )
    if result.returncode != 0:
        raise RuntimeError("cannot inspect local branch upstreams")

    branches = []
    for line in result.stdout.splitlines():
        ref, _, tracking = line.partition("\t")
        if tracking == "[gone]":
            branches.append(ref.removeprefix("refs/heads/"))
    return branches


def branch_worktrees(root: Path) -> dict[str, Path]:
    result = git("worktree", "list", "--porcelain", "-z", root=root, capture=True)
    if result.returncode != 0:
        raise RuntimeError("cannot inspect Git worktrees")

    worktrees = {}
    for record in result.stdout.split("\0\0"):
        path: Path | None = None
        branch: str | None = None
        for line in record.split("\0"):
            if line.startswith("worktree "):
                path = Path(line.removeprefix("worktree "))
            elif line.startswith("branch refs/heads/"):
                branch = line.removeprefix("branch refs/heads/")
        if path is not None and branch is not None:
            worktrees[branch] = path
    return worktrees


def branches_in_progress(root: Path) -> set[str]:
    result = git("rev-parse", "--git-common-dir", root=root, capture=True)
    if result.returncode:
        raise RuntimeError("cannot inspect worktree operation state")
    common = root / result.stdout.removesuffix("\n")
    directories = [common]
    linked = common / "worktrees"
    if linked.exists():
        directories.extend(path for path in linked.iterdir() if path.is_dir())
    branches = set()
    for directory in directories:
        for marker in ("rebase-merge/head-name", "rebase-apply/head-name", "BISECT_START",
                       "rebase-merge/update-refs"):
            try:
                branch = os.fsdecode((directory / marker).read_bytes()).removesuffix("\n")
            except FileNotFoundError:
                continue
            for line in branch.splitlines():
                if marker != "rebase-merge/update-refs" or line.startswith("refs/heads/"):
                    branches.add(line.removeprefix("refs/heads/"))
    return branches


def changed_files(root: Path, *commits: str) -> tuple[tuple[bytes, bytes], ...]:
    result = git(
        "diff-tree", "--root", "--no-commit-id", "-r", "-z", "--no-renames",
        "--no-abbrev", "--no-relative", "--no-ext-diff", "--no-textconv",
        "--ignore-submodules=none", *commits, root=root, capture=True,
        original_objects=True,
    )
    if result.returncode:
        raise RuntimeError("cannot compare exact file changes")
    raw = os.fsencode(result.stdout)
    if not raw:
        return ()
    if not raw.endswith(b"\0"):
        raise RuntimeError("unexpected file-change output")
    fields = raw.split(b"\0")[:-1]
    records = tuple(sorted(zip(fields[::2], fields[1::2], strict=True)))
    if any(not header.startswith(b":") or not path for header, path in records):
        raise RuntimeError("unexpected file-change record")
    return records


def merged_into_main(root: Path, tip: str, main_tip: str) -> bool:
    result = git(
        "merge-base",
        "--is-ancestor",
        tip,
        main_tip,
        root=root,
        capture=True,
        original_objects=True,
    )
    if result.returncode == 0:
        return True
    if result.returncode != 1:
        raise RuntimeError(
            f"git merge-base failed with exit status {result.returncode}"
        )

    shallow = git("rev-parse", "--is-shallow-repository", root=root, capture=True)
    if shallow.returncode:
        raise RuntimeError("cannot inspect repository history")
    if shallow.stdout.strip() != "false":
        return False
    bases = git("merge-base", "--all", tip, main_tip, root=root, capture=True,
                original_objects=True)
    if bases.returncode == 1:
        return False
    if bases.returncode:
        raise RuntimeError("cannot inspect merge bases")
    if len(bases.stdout.splitlines()) != 1:
        return False
    base = bases.stdout.strip()
    changes = changed_files(root, base, tip)
    if not changes:
        return False
    candidates = git(
        "--literal-pathspecs", "rev-list", "--no-merges", "--full-history",
        main_tip, f"^{base}", "--", os.fsdecode(changes[0][1]),
        root=root, capture=True, original_objects=True,
    )
    if candidates.returncode:
        raise RuntimeError("cannot inspect squash-merge candidates")
    return any(changed_files(root, commit) == changes
               for commit in candidates.stdout.splitlines())


def prune_gone_branch(
    root: Path,
    branch: str,
) -> str | None:
    tip_result = git("rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}",
                     root=root, capture=True)
    main_result = git("rev-parse", "--verify", "refs/remotes/origin/main^{commit}",
                      root=root, capture=True)
    if tip_result.returncode or main_result.returncode:
        raise RuntimeError("cannot pin branch and main commits")
    tip = tip_result.stdout.strip()
    main_tip = main_result.stdout.strip()
    if not merged_into_main(root, tip, main_tip):
        return "not proven merged"

    if branch in branch_worktrees(root) or branch in branches_in_progress(root):
        return "in use"

    recovery = f"refs/gb/pruned/{branch}/{tip}"
    symbolic = git("symbolic-ref", "--quiet", recovery, root=root, capture=True)
    if symbolic.returncode != 1:
        raise RuntimeError("recovery ref must be a direct commit reference")
    existing = git("show-ref", "--verify", "--quiet", recovery,
                   root=root, capture=True)
    if existing.returncode == 0:
        recovery_command = f"verify {recovery} {tip}"
    elif existing.returncode == 1:
        recovery_command = f"create {recovery} {tip}"
    else:
        raise RuntimeError("cannot inspect recovery ref")
    result = git(
        "update-ref", "--no-deref", "--stdin", root=root, capture=True,
        input=(f"{recovery_command}\n"
               f"verify refs/remotes/origin/main {main_tip}\n"
               f"delete refs/heads/{branch} {tip}\n"),
    )
    if result.returncode != 0:
        raise RuntimeError(
            f"recovery/pruning transaction failed with exit status {result.returncode}"
        )
    config = git("config", "--remove-section", f"branch.{branch}", root=root, capture=True)
    if config.returncode:
        print(f"gb: warning: could not remove obsolete config for {branch}", file=sys.stderr)
    print(
        f"gb: pruned local branch {branch} (upstream gone); "
        f"restore: git branch {shlex.quote(branch)} {shlex.quote(recovery)}",
        file=sys.stderr,
    )


def prune_gone_branches(root: Path, current_branch: str, target_branch: str) -> None:
    try:
        result = git(
            "show-ref",
            "--verify",
            "--quiet",
            "refs/remotes/origin/main",
            root=root,
            capture=True,
        )
        if result.returncode == 1:
            raise RuntimeError("origin/main is unavailable")
        if result.returncode != 0:
            raise RuntimeError(
                f"cannot inspect origin/main (exit status {result.returncode})"
            )
        branches = gone_branches(root)
        worktrees = branch_worktrees(root)
        operations = branches_in_progress(root)
    except Exception as error:
        print(f"gb: warning: local branch pruning failed: {error}", file=sys.stderr)
        return

    kept: Counter[str] = Counter()
    for branch in branches:
        if branch in ("main", current_branch, target_branch,
                       os.environ.get("GW_PRESERVE_BRANCH")):
            continue
        if branch in operations or branch in worktrees:
            kept["in use"] += 1
            continue
        try:
            reason = prune_gone_branch(root, branch)
            if reason:
                kept[reason] += 1
        except Exception as error:
            print(
                f"gb: warning: failed to prune local branch {branch}: {error}",
                file=sys.stderr,
            )
    if kept:
        reasons = "; ".join(f"{count} {reason}" for reason, count in kept.items())
        count = sum(kept.values())
        noun = "branch" if count == 1 else "branches"
        print(f"gb: kept {count} local {noun} ({reasons})", file=sys.stderr)


def prepare_branch_switch(root: Path, branch: str) -> bool:
    path = branch_worktrees(root).get(branch)
    if path is None:
        return True

    if path.resolve() == root.resolve():
        return True
    print(
        f"error: branch {branch} is checked out in another worktree: {path}; "
        "use or restore that checkout; remove it explicitly with gw rm, "
        "or use git worktree prune for a missing checkout",
        file=sys.stderr,
    )
    return False


def main() -> int:
    root = git_root()
    if root is None:
        return 1

    head = git("symbolic-ref", "-q", "--short", "HEAD", root=root, capture=True)
    if head.returncode:
        print("error: refusing to leave a detached Git HEAD", file=sys.stderr)
        return 1
    current_branch = head.stdout.removesuffix("\n")

    operation = in_progress_operation(root)
    if operation:
        print(f"error: refusing to interrupt {operation}", file=sys.stderr)
        return 1

    result = git(
        "fetch", "--prune", "--no-prune-tags", "--no-tags", "--refmap=",
        "origin", "+refs/heads/*:refs/remotes/origin/*", root=root,
    )
    if result.returncode != 0:
        return result.returncode

    branch, cmd = parse_args(sys.argv[1:], root)

    prune_gone_branches(root, current_branch, branch)

    if not branch or branch.startswith("-"):
        print(f"error: invalid branch name: {branch}", file=sys.stderr)
        return 1

    if git("check-ref-format", "--branch", branch, root=root, capture=True).returncode:
        print(f"error: invalid branch name: {branch}", file=sys.stderr)
        return 1

    if not prepare_branch_switch(root, branch):
        return 1

    status = git("status", "--porcelain", root=root, capture=True)
    if status.returncode != 0:
        return status.returncode
    if status.stdout:
        result = git(
            "stash",
            "push",
            "--include-untracked",
            "-m",
            f"gb auto-stash before syncing {branch}",
            root=root,
        )
        if result.returncode != 0:
            return result.returncode
        print(
            "gb: stashed local changes; restore with git stash pop",
            file=sys.stderr,
        )

    local_branch = git(
        "show-ref", "--verify", "--quiet", f"refs/heads/{branch}", root=root
    )
    if local_branch.returncode == 0:
        switch = ("switch", "--no-overwrite-ignore", branch)
    elif local_branch.returncode == 1:
        switch = ("switch", "--no-overwrite-ignore", "--track", "-c", branch, f"origin/{branch}")
    else:
        return local_branch.returncode

    result = git(*switch, root=root)
    if result.returncode != 0:
        return result.returncode

    result = git("merge", "--ff-only", "--no-overwrite-ignore", f"origin/{branch}", root=root)
    if result.returncode != 0:
        return result.returncode

    if cmd:
        return exec_command(cmd)
    return 0


if __name__ == "__main__":
    try:
        code = main()
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        code = 130
    except Exception as error:
        print(f"error: {error}", file=sys.stderr)
        code = 1
    raise SystemExit(code)
