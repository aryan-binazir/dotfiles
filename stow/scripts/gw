#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

"""
A standalone script cannot change its parent shell's directory. Add this
line to ~/.bashrc, then reload that file:

source "$HOME/repos/dotfiles/shell/gw.bash"
"""

from pathlib import Path
import os
import subprocess
import sys


def die(message: str, code: int = 1) -> None:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(code)


def run(command: list[str], *, cwd: Path) -> int:
    return subprocess.run(command, cwd=cwd, stdout=sys.stderr).returncode


def git(
    args: list[str],
    *,
    cwd: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", *args],
        cwd=cwd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return subprocess.CompletedProcess(
        result.args, result.returncode,
        os.fsdecode(result.stdout), os.fsdecode(result.stderr),
    )


def git_root() -> Path:
    result = git(["rev-parse", "--show-toplevel"])
    if result.returncode != 0:
        die("not inside a Git repository")
    return Path(result.stdout.rstrip("\n"))


def is_linked_worktree(root: Path) -> bool:
    result = git(["rev-parse", "--git-dir", "--git-common-dir"], cwd=root)
    if result.returncode != 0:
        die("failed to inspect git directories")
    git_dir, common_dir = result.stdout.splitlines()[:2]
    return (root / git_dir).resolve() != (root / common_dir).resolve()


def existing_worktree(root: Path, branch_ref: str) -> Path | None:
    result = git(["worktree", "list", "--porcelain"], cwd=root)
    if result.returncode != 0:
        die(result.stderr.strip() or "git worktree list failed", result.returncode)

    branch_name = branch_ref.removeprefix("refs/heads/")
    for record in result.stdout.split("\n\n"):
        path: Path | None = None
        branch: str | None = None
        for line in record.splitlines():
            if line.startswith("worktree "):
                path = Path(line.removeprefix("worktree "))
            elif line.startswith("branch "):
                branch = line.removeprefix("branch ")
        if branch != branch_ref:
            continue
        if path is not None and path.is_dir():
            return path
        status = run(["git", "worktree", "prune"], cwd=root)
        if status != 0:
            die(
                f"worktree for {branch_name} is missing ({path}); "
                "run: git worktree prune",
                status,
            )
        return None
    return None


def worktree_records(root: Path) -> list[dict[str, str]]:
    # -z disables Git's path quoting and separates even newline-containing paths.
    result = subprocess.run(
        ["git", "worktree", "list", "--porcelain", "-z"], cwd=root,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        die(os.fsdecode(result.stderr).strip() or "git worktree list failed",
            result.returncode)
    records: list[dict[str, str]] = []
    record: dict[str, str] = {}
    for field in result.stdout.split(b"\0"):
        if not field:
            if record:
                records.append(record)
                record = {}
            continue
        key, _, value = field.partition(b" ")
        record[os.fsdecode(key)] = os.fsdecode(value)
    if record:
        records.append(record)
    return records


def removal_blocker(root: Path, record: dict[str, str], *, force: bool = False) -> str | None:
    worktree = Path(record["worktree"])
    if "locked" in record:
        return "locked worktree" + (f": {record['locked']}" if record['locked'] else "")
    if worktree.is_symlink():
        return "worktree path is a symlink"
    if not worktree.is_dir():
        return "registered path is missing (not pruned)"

    # Do not inspect/remove a different repository that replaced a registered path.
    actual = git(["rev-parse", "--show-toplevel"], cwd=worktree)
    common = git(["rev-parse", "--git-common-dir"], cwd=worktree)
    expected = git(["rev-parse", "--git-common-dir"], cwd=root)
    if (actual.returncode or common.returncode or expected.returncode
            or Path(actual.stdout.rstrip("\n")).resolve() != worktree.resolve()
            or (worktree / common.stdout.rstrip("\n")).resolve()
            != (root / expected.stdout.rstrip("\n")).resolve()):
        return "registered path is not this repository's worktree"

    # Explicit bulk force discards local files and unfinished operations, but
    # never overrides the identity, missing-path, or lock checks above.
    if force:
        return None

    result = git(["rev-parse", "--absolute-git-dir"], cwd=worktree)
    if result.returncode:
        return result.stderr.strip() or "failed to inspect git directory"
    git_dir = Path(result.stdout.rstrip("\n"))
    for marker in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge",
                   "rebase-apply", "sequencer", "BISECT_START", "index.lock", "HEAD.lock"):
        if (git_dir / marker).exists():
            return f"Git operation in progress ({marker})"

    result = git(
        ["status", "--porcelain", "--untracked-files=all", "--ignored",
         "--ignore-submodules=none"], cwd=worktree,
    )
    if result.returncode:
        return result.stderr.strip() or "failed to inspect worktree"
    if result.stdout:
        return "worktree has local changes or files (including ignored files)"
    return None


def remove_registered(root: Path, record: dict[str, str], *, force: bool = False) -> str | None:
    """Return a refusal/failure reason, without ever deleting a branch."""
    try:
        reason = removal_blocker(root, record, force=force)
        if reason:
            return reason
        # A single --force cannot override a worktree lock (unlike double force).
        flags = ["--force"] if force else []
        result = git(["worktree", "remove", *flags, record["worktree"]], cwd=root)
        if result.returncode:
            return result.stderr.strip() or "git worktree remove failed"
    except OSError as error:
        return str(error)
    return None


def remove_all_worktrees(root: Path, *, force: bool = False) -> int:
    records = worktree_records(root)
    failed = False
    # Git lists the main worktree first, including when called from a linked one.
    primary = Path(records[0]["worktree"]).resolve()
    for record in records:
        path = Path(record["worktree"])
        if path.resolve() == primary:
            reason = "primary checkout"
        elif path.resolve() == root.resolve():
            reason = "current worktree"
        else:
            reason = remove_registered(root, record, force=force)
            if reason:
                failed = True
        if reason:
            print(f"skipped: {path}: {reason}", file=sys.stderr)
        else:
            print(f"removed: {path}", file=sys.stderr)
    return int(failed)


def remove_worktree(root: Path, name: str) -> int:
    worktree = Path.home() / "repos" / ".worktrees" / root.name / name
    record = next((record for record in worktree_records(root)
                   if Path(record["worktree"]).resolve() == worktree.resolve()), None)
    if worktree.is_symlink() or record is None:
        die(f"target is not a registered worktree of this repository: {worktree}")
    if worktree.resolve() == root.resolve():
        die("cannot remove the primary checkout")
    reason = remove_registered(root, record)
    if reason:
        die(f"{reason}: {worktree}")
    return 0


def main() -> int:
    args = sys.argv[1:]
    usage = "usage: gw <name> | gw list | gw rm <name> | gw rm --all [--force]"
    if not args:
        die(usage)
    if args[0] == "list":
        if len(args) != 1:
            die(usage)
        result = git(["worktree", "list"], cwd=git_root())
        if result.returncode != 0:
            die(result.stderr.strip() or "git worktree list failed", result.returncode)
        print(result.stdout, end="")
        return 0

    removing = args[0] == "rm"
    if removing and args[1:] in (["--all"], ["--all", "--force"], ["--force", "--all"]):
        return remove_all_worktrees(git_root(), force="--force" in args[1:])
    if len(args) != (2 if removing else 1):
        die(usage)
    requested = args[1] if removing else args[0]
    if requested.startswith(("amb/", "aryan-binazir/")):
        branch = requested
        name = requested.split("/", 1)[1]
    else:
        name = requested
        branch = f"amb/{name}"
    if (
        not name
        or name.startswith("-")
        or "/" in name
        or git(["check-ref-format", "--branch", branch]).returncode != 0
    ):
        die(f"invalid worktree name: {name}")

    root = git_root()
    if is_linked_worktree(root):
        die("run gw from the primary checkout, not a linked worktree")

    if removing:
        return remove_worktree(root, name)

    status = run(["gb"], cwd=root)
    if status != 0:
        return status

    status = run(["git", "worktree", "prune"], cwd=root)
    if status != 0:
        return status

    worktree = Path.home() / "repos" / ".worktrees" / root.name / name
    worktree.parent.mkdir(parents=True, exist_ok=True)
    branch_ref = f"refs/heads/{branch}"
    branch_exists = git(["show-ref", "--verify", "--quiet", branch_ref], cwd=root)
    if branch_exists.returncode not in (0, 1):
        die("git show-ref failed", branch_exists.returncode)

    if branch_exists.returncode == 0:
        existing = existing_worktree(root, branch_ref)
        if existing is not None:
            print(
                f"branch exists: {branch}; using existing checkout: {existing}",
                file=sys.stderr,
            )
            print(existing)
            return 0
        print(f"branch exists: {branch}; checking it out", file=sys.stderr)
        command = ["git", "worktree", "add", str(worktree), branch]
    else:
        command = ["git", "worktree", "add", "-b", branch, str(worktree), "main"]

    status = run(command, cwd=root)
    if status != 0:
        return status

    print(worktree)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        die("interrupted", 130)
    except FileNotFoundError as error:
        die(f"command not found: {error.filename}", 127)
