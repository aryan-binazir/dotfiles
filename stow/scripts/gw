#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///

from pathlib import Path
import subprocess
import sys


def run(command: list[str], *, cwd: Path) -> int:
    try:
        return subprocess.run(command, cwd=cwd, stdout=sys.stderr).returncode
    except FileNotFoundError:
        print(f"error: command not found: {command[0]}", file=sys.stderr)
        return 127


def git_root() -> Path | None:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        print("error: command not found: git", file=sys.stderr)
        return None
    if result.returncode != 0:
        print("error: not inside a Git repository", file=sys.stderr)
        return None
    return Path(result.stdout.strip())


def main() -> int:
    if len(sys.argv) != 2:
        print("error: usage: gw <name>", file=sys.stderr)
        return 1

    name = sys.argv[1]
    branch = f"aryan-binazir/{name}"
    if not name or name.startswith("-") or "/" in name:
        print(f"error: invalid worktree name: {name}", file=sys.stderr)
        return 1

    root = git_root()
    if root is None:
        return 1

    branch_check = subprocess.run(
        ["git", "check-ref-format", "--branch", branch],
        cwd=root,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if branch_check.returncode != 0:
        print(f"error: invalid worktree name: {name}", file=sys.stderr)
        return 1

    if run(["gb"], cwd=root) != 0:
        return 1

    worktree = root / "_scratch" / "worktrees" / name
    worktree.parent.mkdir(parents=True, exist_ok=True)
    if run(["git", "worktree", "add", "-b", branch, str(worktree), "main"], cwd=root) != 0:
        return 1

    print(worktree)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("error: interrupted", file=sys.stderr)
        raise SystemExit(130)
    except Exception as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
